{
  "name": {"type": "string", "initialValue": "John"},
  "age": {"type": "number", "initialValue": 25},
  "isActive": {"type": "boolean", "initialValue": true},
  "items": {"type": "array", "initialValue": ["apple", "banana", "cherry"]},
  "user": {"type": "object", "initialValue": {"firstName": "Jane", "lastName": "Doe", "age": 30, "email": "jane@example.com"}},
  "emptyString": {"type": "string", "initialValue": ""},
  "zero": {"type": "number", "initialValue": 0},
  "nums": {"type": "array", "initialValue": [3, 1, 4, 1, 5, 9, 2, 6]},
  "mixed": {"type": "array", "initialValue": [1, "2", 3.5, true, null, "abc"]},
  "price": {"type": "number", "initialValue": 24.99},
  "half": {"type": "number", "initialValue": 0.5},
  "neg": {"type": "number", "initialValue": -7.5},
  "big": {"type": "number", "initialValue": 1e20},
  "products": {"type": "array", "initialValue": [
    {"id": 1, "name": "Shirt", "price": 35, "active": true, "categoryId": 10},
    {"id": 2, "name": "Jeans", "price": 80, "active": true, "categoryId": 20},
    {"id": 3, "name": "Jacket", "price": 120.5, "active": false, "categoryId": 10},
    {"id": 4, "name": "Dress", "price": 60, "active": true, "categoryId": 20}
  ]},
  "nested": {"type": "object", "initialValue": {"a": {"b": [1, {"c": "deep"}]}}},
  "nullField": {"type": "object", "initialValue": {"x": null, "y": 0}},
  "dateStr": {"type": "string", "initialValue": "2026-01-12"},
  "isoStr": {"type": "string", "initialValue": "2026-01-12T14:30:00Z"},
  "strNum": {"type": "string", "initialValue": "42"},
  "emoji": {"type": "string", "initialValue": "👍🏽ok"},
  "accented": {"type": "string", "initialValue": "éte"},
  "words": {"type": "string", "initialValue": "  hello world  "},
  "hexStr": {"type": "string", "initialValue": "0x1A"},
  "nanStr": {"type": "string", "initialValue": "nan"},
  "infStr": {"type": "string", "initialValue": "inf"},
  "dup": {"type": "array", "initialValue": [1, 1.0, "1"]},
  "emptyArr": {"type": "array", "initialValue": []},
  "emptyObj": {"type": "object", "initialValue": {}},
  "fullName": {"type": "string", "computed": "{{name + ' ' + user.lastName}}"},
  "nilComputed": {"type": "object", "computed": "{{first(items, item == 'zzz')}}"},
  "fromInit": {"type": "string", "initialValue": "{{first(items)}}"},
  "decimals": {"type": "array", "initialValue": [0.1, 0.2, 0.30000000000000004, 1.005, 2.5, -2.5, 1e-7, 123456789012.5]}
}
