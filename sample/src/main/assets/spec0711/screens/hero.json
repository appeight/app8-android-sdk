{
 "type": "screen",
 "id": "hero",
 "content": {
  "navigationBar": {
   "hidden": true
  },
  "properties": {
   "backgroundColor": "#FFFFFF"
  },
  "children": [
   {
    "type": "scrollView",
    "id": "scroll",
    "content": {
     "properties": {
      "stretchesTopChild": true,
      "contentInsetAdjustment": "bottom"
     },
     "layout": {
      "constraints": [
       {
        "type": "top",
        "target": "superview"
       },
       {
        "type": "bottom",
        "target": "superview"
       },
       {
        "type": "leading",
        "target": "superview"
       },
       {
        "type": "trailing",
        "target": "superview"
       }
      ]
     },
     "children": [
      {
       "type": "stackView",
       "id": "stack",
       "content": {
        "properties": {
         "axis": "vertical",
         "spacing": 12
        },
        "layout": {
         "constraints": [
          {
           "type": "top",
           "target": "superview"
          },
          {
           "type": "bottom",
           "target": "superview"
          },
          {
           "type": "leading",
           "target": "superview"
          },
          {
           "type": "trailing",
           "target": "superview"
          },
          {
           "type": "width",
           "target": "superview",
           "attribute": "width"
          }
         ]
        },
        "children": [
         {
          "type": "view",
          "id": "heroBox",
          "content": {
           "layout": {
            "height": 420
           },
           "children": [
            {
             "type": "collection",
             "id": "pager",
             "content": {
              "properties": {
               "data": "{{pages}}",
               "layout": {
                "type": "horizontal",
                "itemHeight": 420,
                "pagingStyle": "paging"
               }
              },
              "template": {
               "id": "page",
               "type": "image",
               "content": {
                "properties": {
                 "type": "remoteAsset",
                 "name": "{{item.image}}"
                },
                "style": {
                 "contentMode": "scaleAspectFill"
                }
               }
              },
              "layout": {
               "constraints": [
                {
                 "type": "top",
                 "target": "superview"
                },
                {
                 "type": "bottom",
                 "target": "superview"
                },
                {
                 "type": "leading",
                 "target": "superview"
                },
                {
                 "type": "trailing",
                 "target": "superview"
                }
               ]
              }
             }
            }
           ]
          }
         },
