           "style": {
            "text": {
             "fontSize": 26,
             "fontWeight": "bold",
             "color": "#111111"
            }
           },
           "layout": {
            "constraints": [
             {
              "type": "leading",
              "target": "superview",
              "constant": 16
             },
             {
              "type": "trailing",
              "target": "superview",
              "constant": -16
             }
            ]
           }
          }
